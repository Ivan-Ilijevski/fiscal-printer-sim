# OAuth client ID created in the Google Cloud Console.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# OAuth client secret paired with the client ID.
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# A long random string used to sign the app's session cookies.
AUTH_SESSION_SECRET=YOUR_AUTH_SESSION_SECRET

# Shared secret for POST /api/receipt/render, sent as the x-api-key header.
# Unset means the endpoint refuses every request with 503.
RECEIPT_API_KEY=YOUR_RECEIPT_API_KEY
